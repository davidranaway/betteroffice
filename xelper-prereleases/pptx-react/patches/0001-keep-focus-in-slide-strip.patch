+      require() {} } as unknown as PeerlessPresentation;
+    const view = render(<PeerlessSlideStrip run={run}
+      previewFit={() => ({ scale: 0.25, dpr: 2, generation: 1 })} current={() => true} />);
+    try {
+      await flushStage();
+      const buttons = [...view.container.querySelectorAll<HTMLButtonElement>('button[data-slide-id]')];
+      expect(buttons).toHaveLength(2);
+
+      buttons[0]!.focus();
+      const untouched = client.sent.length;
+      for (const modifiers of [{ ctrlKey: true }, { metaKey: true }, { shiftKey: true }, { isComposing: true }]) {
+        expect(fireEvent.keyDown(buttons[0]!, { key: 'ArrowDown', ...modifiers })).toBe(true);
+        expect(document.activeElement).toBe(buttons[0]);
+        expect(client.sent).toHaveLength(untouched);
+      }
+
+      expect(fireEvent.keyDown(buttons[0]!, { key: 'ArrowUp' })).toBe(false);
+      expect(document.activeElement).toBe(buttons[0]);
+      expect(client.sent).toHaveLength(untouched);
+
+      expect(fireEvent.keyDown(buttons[0]!, { key: 'ArrowDown' })).toBe(false);
+      await flushStage();
+      expect(document.activeElement).toBe(buttons[1]);
+      expect(client.sent[client.sent.length - 1]).toMatchObject({
+        kind: 'activateSlide', payload: { slideId: 'other' },
+      });
+
+      const atEnd = client.sent.length;
+      expect(fireEvent.keyDown(buttons[1]!, { key: 'ArrowDown' })).toBe(false);
+      expect(document.activeElement).toBe(buttons[1]);
+      expect(client.sent).toHaveLength(atEnd);
+
+      expect(fireEvent.keyDown(buttons[1]!, { key: 'ArrowUp' })).toBe(false);
+      await flushStage();
+      expect(document.activeElement).toBe(buttons[0]);
+      expect(client.sent[client.sent.length - 1]).toMatchObject({
+        kind: 'activateSlide', payload: { slideId: 'slide' },
+      });
+
+      fireEvent.pointerDown(buttons[0]!, { button: 0, isPrimary: true });
+      fireEvent.click(buttons[0]!);
+      await flushStage();
+      expect(document.activeElement).toBe(buttons[0]);
+
+      expect(fireEvent.keyDown(buttons[0]!, { key: 'ArrowDown' })).toBe(false);
+      await flushStage();
+      expect(document.activeElement).toBe(buttons[1]);
+
+      const beforeReorder = client.sent.length;
+      expect(fireEvent.keyDown(buttons[1]!, { key: 'ArrowUp', altKey: true })).toBe(false);
+      expect(document.activeElement).toBe(buttons[1]);
+      expect(client.sent).toHaveLength(beforeReorder + 1);
+      expect(client.sent[client.sent.length - 1]).toMatchObject({
+        kind: 'invoke', payload: { method: 'moveSlide', args: ['other', 0] },
+      });
+    } finally { view.unmount(); store.dispose(); images.dispose(); }
+  });
